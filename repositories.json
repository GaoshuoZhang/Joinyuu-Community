{
  "schemaVersion": 1,
  "description": "Four independent business repositories. Keep remote URLs synchronized with each repository's origin.",
  "repositories": [
    {
      "id": "api",
      "name": "Joinyuu-API",
      "path": "apps/api",
      "remote": "https://github.com/GaoshuoZhang/Joinyuu-api.git",
      "defaultBranch": "main",
      "packageManager": "pnpm"
    },
    {
      "id": "admin",
      "name": "Joinyuu-Admin",
      "path": "apps/admin",
      "remote": "https://github.com/GaoshuoZhang/Joinyuu-admin.git",
      "defaultBranch": "main",
      "packageManager": "pnpm"
    },
    {
      "id": "client-mobile",
      "name": "Joinyuu-Client-Mobile",
      "path": "apps/client-mobile",
      "remote": "https://github.com/GaoshuoZhang/Joinyuu-client-mobile.git",
      "defaultBranch": "main",
      "packageManager": "pnpm"
    },
    {
      "id": "wxminiprogram",
      "name": "Joinyuu-WXMiniProgram",
      "path": "apps/wxminiprogram",
      "remote": "https://github.com/GaoshuoZhang/Joinyuu-client-wxminiprogram.git",
      "defaultBranch": "main",
      "packageManager": "npm"
    }
  ]
}
