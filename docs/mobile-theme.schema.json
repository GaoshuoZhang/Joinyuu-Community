{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joinyuu Mobile Theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,5}\\.\\d{1,5}\\.\\d{1,5}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "slogan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "logo": {
          "type": "string",
          "pattern": "^assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(png|jpg|jpeg|webp)$"
        },
        "homeBackground": {
          "type": "string",
          "pattern": "^assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(png|jpg|jpeg|webp)$"
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "highlight": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "logoDark": {
          "type": "string",
          "pattern": "^assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(png|jpg|jpeg|webp)$"
        },
        "logoShape": {
          "enum": [
            "square",
            "wordmark"
          ]
        }
      },
      "dependentRequired": {
        "logoDark": [
          "logo"
        ],
        "highlight": [
          "headline"
        ]
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "secondaryText": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "primaryLight": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "heroStart": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "heroEnd": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "secondaryText": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "primaryLight": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "heroStart": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "heroEnd": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "radius": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "default",
            "brand"
          ]
        },
        "homeModules": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": [
              "banner",
              "entries",
              "publish",
              "activation",
              "announcement",
              "events",
              "demands",
              "articles"
            ]
          }
        }
      }
    }
  }
}
