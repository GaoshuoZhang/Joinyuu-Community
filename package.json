{
  "name": "joinyuu-community",
  "private": true,
  "version": "1.5.0",
  "description": "聚屿社区 Joinyuu Community — 创业社区数字化运营平台",
  "scripts": {
    "dev:admin": "pnpm --filter @joinyuu/admin dev",
    "build:admin": "pnpm --filter @joinyuu/admin build",
    "dev:client-mobile": "pnpm --filter @joinyuu/client-mobile dev",
    "dev:it": "node scripts/integration.mjs start",
    "build:client-mobile": "pnpm --filter @joinyuu/client-mobile build",
    "dev:api": "pnpm --filter @joinyuu/api dev",
    "build:api": "pnpm --filter @joinyuu/api build",
    "db:up": "docker compose -f apps/api/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f apps/api/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @joinyuu/api db:migrate",
    "db:seed": "pnpm --filter @joinyuu/api db:seed",
    "db:init": "pnpm --filter @joinyuu/api db:init",
    "db:reset": "pnpm --filter @joinyuu/api db:reset",
    "test:e2e:it": "node scripts/integration.mjs test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "typescript-eslint": "^8.70.0"
  }
}
