{
  "name": "joinyuu-community",
  "private": true,
  "version": "1.6.2",
  "description": "聚屿社区多仓协作工作区：独立应用、统一开发入口",
  "scripts": {
    "dev:admin": "pnpm --dir apps/admin dev",
    "build:admin": "pnpm --dir apps/admin build",
    "dev:client-mobile": "pnpm --dir apps/client-mobile dev",
    "dev:it": "node scripts/integration.mjs start",
    "build:client-mobile": "pnpm --dir apps/client-mobile build",
    "dev:api": "pnpm --dir apps/api dev",
    "build:api": "pnpm --dir apps/api build",
    "start": "pnpm --dir apps/api start",
    "start:api": "pnpm --dir apps/api build && pnpm --dir apps/api start",
    "serve:admin": "pnpm --dir apps/admin serve",
    "serve:mobile": "pnpm --dir apps/client-mobile serve",
    "start:admin": "pnpm --dir apps/admin build && pnpm --dir apps/admin serve",
    "start:mobile": "pnpm --dir apps/client-mobile build && pnpm --dir apps/client-mobile serve",
    "db:up": "pnpm --dir apps/api db:up",
    "db:down": "pnpm --dir apps/api db:down",
    "db:migrate": "pnpm --dir apps/api db:migrate",
    "db:seed": "pnpm --dir apps/api db:seed",
    "db:init": "pnpm --dir apps/api db:init",
    "db:reset": "pnpm --dir apps/api db:reset",
    "test:e2e:it": "node scripts/integration.mjs test",
    "lint": "node scripts/workspace.mjs lint",
    "lint:fix": "pnpm --dir apps/api lint:fix && pnpm --dir apps/admin lint:fix && pnpm --dir apps/client-mobile lint:fix",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "workspace:init": "node scripts/workspace.mjs init",
    "workspace:status": "node scripts/workspace.mjs status",
    "install:all": "node scripts/workspace.mjs install",
    "dev:all": "node scripts/workspace.mjs dev",
    "test": "node --test scripts/workspace.test.mjs && node scripts/workspace.mjs test",
    "build": "node scripts/workspace.mjs build",
    "check": "node scripts/workspace.mjs check",
    "release:record": "node scripts/workspace.mjs record-release",
    "test:mini": "npm --prefix apps/wxminiprogram test",
    "test:workspace": "node --test scripts/workspace.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:generate": "node scripts/generate-reference.mjs"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  }
}
