# =============================================================================
# 聚屿社区后端 · 环境变量模板（复制为 apps/api/.env 使用；.env 不入库）
# =============================================================================
#
# 【服务器首次上线初始化顺序】
#   1. cp apps/api/.env.example apps/api/.env，按下文「一」填写必填项
#   2. pnpm install
#   3. pnpm db:migrate    # 应用数据库迁移（勿用 pnpm db:reset：会清空数据库）
#   4. pnpm db:init       # 写入基础配置（字典/权限点/角色/超管账号/系统配置/渠道与模板/发号序列），
#                         # 不含演示数据；初始密码取 INIT_ADMIN_PASSWORD，未配置则随机生成并打印一次
#                         # 仅本地开发/试用需要演示数据时才用 pnpm db:seed；已有数据的库会被 db:init 拒绝
#   5. pnpm build:api && pnpm --filter @joinyuu/api start   # 监听 0.0.0.0:7757
#   6. 管理后台首登（超管 admin + 第 4 步的初始密码）→ 立即改密码
#      →「系统管理 → 系统配置 → 许可证管理」导入 .license（未授权时全站只读）
#      → 按需开启 MinIO、设置站点名称等业务配置
#   7. 需要真实收发短信/邮件时，按「四」注入凭据，并在「消息中心」把渠道凭据来源设为「环境变量」
#
# 管理端（apps/admin）与移动端（apps/client-mobile）不读取环境变量：生产由网关同源转发 /api。
#
# 【本地开发】DATABASE_URL / REDIS_URL 指向本机；NODE_ENV 改为 development；JWT_SECRET 可用占位值。
# 注意 Windows + Docker Desktop 下 IPv6 loopback（::1）端口转发不可靠，一律用 127.0.0.1 而非 localhost。

# -----------------------------------------------------------------------------
# 一、必填
# -----------------------------------------------------------------------------
# 生产必须显式设为 production：此时缺少 JWT_SECRET 后端启动即失败；
# 且只有 production 会关闭联调兜底（短信/邮箱验证码回显 devCode、消息渠道凭据缺失时干跑）。
NODE_ENV="production"
# PostgreSQL。云托管实例通常需追加 SSL 参数，如：?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/joinyuu?schema=public"
# Redis。生产建议启用密码并使用独立 db：redis://:PASSWORD@127.0.0.1:6379/0
REDIS_URL="redis://127.0.0.1:6379"
# 生成方式：openssl rand -hex 32。务必替换，禁止沿用示例值。
JWT_SECRET="CHANGE_ME"
# 仅 db:init 使用：指定超级管理员初始密码；留空则脚本随机生成并打印一次。初始化完成后可删除本项。
# INIT_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# 二、服务与网络
# -----------------------------------------------------------------------------
# 后端监听 0.0.0.0:<PORT>，网关/管理端/移动端均经此访问
PORT=7757
# 全站时间字符串与定时任务按进程时区（UTC+8 约定）。未设置或不符时启动会显著告警
TZ="Asia/Shanghai"
# 反向代理层数：nginx 单层写 1；置 0/false 表示直连且不信任 X-Forwarded-For。
# 审计日志与登录/验证码/短信/邮箱限流都依赖真实 IP，代理后必须正确设置。
TRUST_PROXY=1
# 浏览器直连 API 的跨域白名单（逗号分隔，需带协议）。缺省仅放行本机 7758/7759；
# 同源部署（网关转发 /api）无需配置。
# CORS_ORIGINS="https://admin.example.com,https://m.example.com"

# -----------------------------------------------------------------------------
# 三、文件与对象存储
# -----------------------------------------------------------------------------
# 本地磁盘素材目录，缺省 apps/api/uploads；生产建议指向独立数据盘或挂载卷
# UPLOAD_DIR="/data/joinyuu/uploads"
# MinIO/S3 兼容对象存储：此处只注入密钥，endpoint/port/bucket/是否 TLS 在后台「系统配置」里配置。
# 环境变量优先于数据库值，生产建议只用环境变量注入（后台仅显示脱敏值）。
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""

# -----------------------------------------------------------------------------
# 四、消息渠道凭据（短信 / 邮件真实投递所需）
# -----------------------------------------------------------------------------
# 变量名可在「消息中心」渠道里登记修改，须与这里保持一致；凭据缺失时生产环境投递失败。
# 阿里云短信（种子渠道 MC1 已默认登记这两个变量名）：
# ALIYUN_SMS_ACCESS_KEY_ID=""
# ALIYUN_SMS_ACCESS_KEY_SECRET=""
# 腾讯云短信（在渠道「固定配置」中切换供应商后使用；变量名为自行登记值，下例同联调用法）：
# TENCENT_SMS_SECRET_ID=""
# TENCENT_SMS_SECRET_KEY=""
# SMTP 邮件（种子渠道 MC2 已默认登记；SMTP 主机/端口/发件人在后台渠道配置里填写）：
# SMTP_USER=""
# SMTP_PASSWORD=""
# 实名核验凭据同理：默认「后台直接填写」，如需环境变量模式，自行登记变量名并在此注入。

# -----------------------------------------------------------------------------
# 五、排障开关（默认保持注释，勿在生产常开）
# -----------------------------------------------------------------------------
# Redis 故障时吊销/会话校验默认 fail-closed（返回 503）；置 1 改为降级放行，
# 仅限故障窗口保可用性（窗口期内已吊销令牌仍可能可用）。
# AUTH_REVOCATION_FAIL_OPEN="1"

# 许可证公钥已内置于后端（apps/api/src/common/license/license-public-keys.json），
# 不再读取 LICENSE_PUBLIC_KEYS_FILE：客户服务器无需配置公钥路径。
# 短信/邮件服务商凭据在非生产环境缺失时会降级为「干跑」并在响应中回显验证码（devCode），
# 上线务必设 NODE_ENV=production。
